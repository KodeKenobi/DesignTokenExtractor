{
  "manifest_version": 3,
  "name": "Design Token Extractor",
  "short_name": "Token Extractor",
  "version": "1.1.0",
  "description": "Extract design system tokens (colors, spacing, typography) from any website",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Design Token Extractor"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "tabs", "storage", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "triggerCapture": {
      "suggested_key": {
        "default": "Alt+S",
        "windows": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Trigger Smart Capture"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
